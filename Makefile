# Vesper kernel Makefile
# Copyright (c) Faded Dream OS Project. All rights reserved.
# Source is viewable but may not be copied, modified, or redistributed
# without permission.
#
# Portable build (session 7): no hard-coded paths. The toolchain is
# discovered in this order (first hit wins):
#   1. x86_64-elf-* cross toolchain (preferred, if installed)
#   2. host cc/ld (gcc or clang) IF it honours the freestanding flag
#      set below — verified by scripts/check_cc.sh at build time; a
#      compiler that cannot honour them fails the build with a clear
#      message instead of producing a broken kernel.
# QEMU/OVMF are found via PATH then standard distro locations, with
# QEMU_BIN / OVMF_DIR environment overrides. Everything runs under
# LC_ALL=C so locale never changes tool output parsing.

export LC_ALL := C

SHELL := /usr/bin/env bash

# ---- toolchain discovery ----
ifeq ($(origin CC),default)
  ifeq ($(shell command -v x86_64-elf-gcc >/dev/null 2>&1 && echo yes),yes)
    CC := x86_64-elf-gcc
  else
    CC := gcc
  endif
endif
# LD: the cross linker when a cross gcc was chosen, else plain ld.
# (Never 'gcc' itself as LD: gcc-as-linker adds crt/stdlib wiring we
# explicitly do not want; the kernel links with -nostdlib -T.)
LD := $(shell if [ "$(CC)" = "x86_64-elf-gcc" ] && command -v x86_64-elf-ld >/dev/null 2>&1; then \
              echo x86_64-elf-ld; else command -v ld >/dev/null 2>&1 && echo ld; fi)
OBJCOPY := $(shell if [ "$(CC)" = "x86_64-elf-gcc" ] && command -v x86_64-elf-objcopy >/dev/null 2>&1; then \
              echo x86_64-elf-objcopy; else command -v objcopy >/dev/null 2>&1 && echo objcopy; fi)

# QEMU / OVMF discovery: env override > PATH > distro locations.
QEMU_BIN  ?= $(shell command -v qemu-system-x86_64 2>/dev/null || \
               for f in /usr/bin/qemu-system-x86_64; do [ -x $$f ] && echo $$f && break; done)
OVMF_DIR  ?= $(shell for d in /usr/share/OVMF /usr/share/ovmf /usr/share/edk2/ovmf \
                         /usr/share/qemu/OVMF; do [ -d $$d ] && echo $$d && break; done)
OVMF_CODE ?= $(firstword $(wildcard $(OVMF_DIR)/OVMF_CODE_4M.fd $(OVMF_DIR)/OVMF_CODE.fd))
OVMF_VARS ?= $(firstword $(wildcard $(OVMF_DIR)/OVMF_VARS_4M.fd $(OVMF_DIR)/OVMF_VARS.fd))
QEMU_ROMS ?= $(dir $(QEMU_BIN))../share/qemu
QEMU_ROMS := $(abspath $(QEMU_ROMS))

LIMINE  := thirdparty/limine/limine

KERNEL  := vesper.elf
ISO     := vesper.iso
IMG     := vesper.img
BUILD_ID_HDR := kernel/include/build_id.h

# Build identity (git hash + dirty + compiler version) stamped into a
# generated header on every build; the kernel prints it as the first
# boot line so a photo identifies the exact build. Not committed.
$(BUILD_ID_HDR): FORCE
	@bash scripts/gen_build_id.sh $(CC) $@

.PHONY: FORCE
FORCE:

.PHONY: build-id
build-id: $(BUILD_ID_HDR)

KERNEL_SRCS := $(wildcard kernel/src/*.c)
ASM_SRCS    := kernel/src/isr_stubs.S kernel/src/gdt_flush.S \
               kernel/src/sched_switch_to.S kernel/src/syscall_entry.S \
               kernel/src/init_blob.S
KERNEL_OBJS := $(patsubst kernel/src/%.c,build/%.o,$(KERNEL_SRCS)) \
               build/isr_stubs.o build/gdt_flush.o build/sched_switch_to.o \
               build/syscall_entry.o build/init_blob.o

# objects depend on the generated build id (hash changes = relink)
$(KERNEL_OBJS): $(BUILD_ID_HDR)

CFLAGS := -std=c17 -Wall -Wextra -ffreestanding -nostdlib \
          -fno-stack-protector -fno-pie -fno-pic \
          -fcf-protection=none \
          -mno-red-zone -mno-sse -mno-mmx -mno-avx -mno-3dnow \
          -mcmodel=kernel \
          -O2 -g -fno-omit-frame-pointer \
          -Ikernel/include -Ithirdparty/limine \
          -Wno-override-init

LDFLAGS := -nostdlib -static -z max-page-size=0x1000 -T kernel/linker.ld

.PHONY: all clean run iso img doctor $(KERNEL_SRCS)

all: check-cc $(KERNEL)

# Fail loud if the compiler cannot honour the freestanding flag set:
# a host gcc/clang that silently ignores -mno-sse or -fcf-protection=none
# would emit SSE/CET instructions that fault at boot on real firmware.
.PHONY: check-cc
check-cc: $(BUILD_ID_HDR)
	@bash scripts/check_cc.sh $(CC)

build/%.o: kernel/src/%.c | build
	$(CC) $(CFLAGS) -c $< -o $@

build/isr_stubs.o: kernel/src/isr_stubs.S | build
	$(CC) $(CFLAGS) -c $< -o $@

build/gdt_flush.o: kernel/src/gdt_flush.S | build
	$(CC) $(CFLAGS) -c $< -o $@

build/sched_switch_to.o: kernel/src/sched_switch_to.S | build
	$(CC) $(CFLAGS) -c $< -o $@

build/syscall_entry.o: kernel/src/syscall_entry.S | build
	$(CC) $(CFLAGS) -c $< -o $@

# init_blob.S is GENERATED by scripts/build_init.sh (it embeds the
# init + fault_init blobs and their size/entry/span descriptors).
# With INIT_BIN set, the same script incbins the external binary.
# Running the script produces BOTH build/init*.bin and the .S, so the
# .S rule delegates to the init.bin rule (single source of truth).
kernel/src/init_blob.S: scripts/build_init.sh
	@test -n "$(INIT_BIN)" || true
	bash scripts/build_init.sh

build/init_blob.o: kernel/src/init_blob.S | build
	$(CC) $(CFLAGS) -c $< -o $@

# External init support (session 8, Lucid): INIT_BIN=<path to a flat
# binary linked at 0x400000> replaces the built-in init program.
# build_init.sh reads INIT_BIN from the environment and incbins the
# binary from its original path. Dependency on scripts/build_init.sh
# alone (not user/init.c) when INIT_BIN is set, so an external init
# build does not rebuild the demo init.
INIT_PREREQ = user/init.c scripts/build_init.sh
ifdef INIT_BIN
INIT_PREREQ = scripts/build_init.sh
export INIT_BIN
endif

build/init.bin: $(INIT_PREREQ) | build
	bash scripts/build_init.sh

.PHONY: init-bin
init-bin:
	@test -n "$(INIT_BIN)" || { echo "usage: make iso INIT_BIN=/path/to/lucid.bin"; exit 1; }
	@test -f "$(INIT_BIN)" || { echo "INIT_BIN not found: $(INIT_BIN)"; exit 1; }

.PHONY: init

kernel/src/isr_stubs.S: scripts/gen_isr_stubs.py
	python3 scripts/gen_isr_stubs.py $@

build:
	mkdir -p build

$(KERNEL): check-cc $(KERNEL_OBJS) kernel/linker.ld
	@echo "CC      : $(CC) ($$($(CC) -dumpfullversion -dumpversion 2>/dev/null || $(CC) -dumpversion))  LD: $(LD)"
	$(LD) $(LDFLAGS) $(KERNEL_OBJS) -o $@

# ---- host tool (Limine) ----
$(LIMINE): thirdparty/limine/limine.c
	$(MAKE) -C thirdparty/limine

# ---- ISO (UEFI + BIOS hybrid from Limine blobs) ----
iso: $(ISO)

CONF ?= limine.conf

$(ISO): $(KERNEL) $(LIMINE) $(CONF)
	mkdir -p build/iso_root
	cp $(KERNEL) build/iso_root/
	cp $(CONF) build/iso_root/limine.conf
	cp thirdparty/limine/limine-bios-cd.bin build/iso_root/
	cp thirdparty/limine/limine-uefi-cd.bin build/iso_root/
	cp thirdparty/limine/limine-bios.sys build/iso_root/
	xorriso -as mkisofs -R -r -J -b limine-bios-cd.bin -no-emul-boot \
	    -boot-load-size 4 -boot-info-table -hfsplus \
	    -apm-block-size 2048 --efi-boot limine-uefi-cd.bin \
	    -efi-boot-part --efi-boot-image --protective-msdos-label \
	    build/iso_root -o $(ISO)
	$(LIMINE) bios-install $(ISO)

# ---- disk image (GPT + FAT32 ESP, for USB sticks and QEMU UEFI) ----
# Layout: protective MBR + GPT (scripts/make_gpt.py), one EFI System
# Partition at LBA 2048, FAT32, holding BOOTX64.EFI, limine.conf and
# the kernel. Limine stage is installed for UEFI; BIOS stage sits in
# the ESP as limine-bios.sys with the MBR patched by bios-install.
IMG_SZ_MB := 64
ESP_LBA   := 2048
# ESP ends at total-34 (last LBA - 33 for backup GPT entries, -1 header)
MTOOLS := env MTOOLS_SKIP_CHECK=1

img: $(IMG)

$(IMG): $(KERNEL) $(LIMINE) limine.conf scripts/make_gpt.py | build
	python3 scripts/make_gpt.py $(IMG) $$(( $(IMG_SZ_MB) * 1024 * 1024 )) $(ESP_LBA) $$(( $(IMG_SZ_MB) * 1024 * 1024 / 512 - $(ESP_LBA) - 34 ))
	$(MTOOLS) mformat -i $(IMG)@@$(ESP_LBA)S -c 1 -H $(ESP_LBA) -T $$(( $(IMG_SZ_MB) * 1024 * 1024 / 512 - $(ESP_LBA) - 34 )) -n VESPER ::
	$(MTOOLS) mmd -i $(IMG)@@$(ESP_LBA)S ::/EFI ::/EFI/BOOT
	$(MTOOLS) mcopy -i $(IMG)@@$(ESP_LBA)S thirdparty/limine/BOOTX64.EFI ::/EFI/BOOT/BOOTX64.EFI
	$(MTOOLS) mcopy -i $(IMG)@@$(ESP_LBA)S limine.conf ::/limine.conf
	$(MTOOLS) mcopy -i $(IMG)@@$(ESP_LBA)S $(KERNEL) ::/vesper.elf
	$(MTOOLS) mcopy -i $(IMG)@@$(ESP_LBA)S thirdparty/limine/limine-bios.sys ::/limine-bios.sys
	$(LIMINE) bios-install --force $(IMG) 2 --uninstall-data-file=$(IMG).uninstall
	truncate -s $$(( $(IMG_SZ_MB) * 1024 * 1024 )) $(IMG)

# ---- environment check ----
doctor:
	bash scripts/doctor.sh

# ---- QEMU ----
# Only used by `make run`; OVMF missing => clear message, not a hang.
QEMU_ARGS := -L $(QEMU_ROMS) -machine q35 -m 512M \
    -drive if=pflash,format=raw,file=$(OVMF_CODE),readonly=on \
    -drive if=pflash,format=raw,file=build/OVMF_VARS.fd \
    -cdrom $(ISO) \
    -serial file:build/serial.log -display none -no-reboot

build/OVMF_VARS.fd: $(OVMF_VARS) | build
	cp $(OVMF_VARS) build/OVMF_VARS.fd

# `make run`: boot the ISO under OVMF (UEFI) in QEMU, one command.
# Runs in the foreground with a timeout so CI sandboxes never hang;
# serial output is captured to build/serial.log and dumped on exit.
RUN_SECS ?= 30
run: $(ISO) build/OVMF_VARS.fd
	@test -n "$(QEMU_BIN)" || (echo "run: qemu-system-x86_64 not found (see scripts/doctor.sh)"; exit 1)
	@test -n "$(OVMF_CODE)" || (echo "run: OVMF firmware not found (see scripts/doctor.sh)"; exit 1)
	@rm -f build/serial.log
	@echo ">> qemu (UEFI/OVMF) starting, $(RUN_SECS)s budget; serial -> build/serial.log"
	@timeout $(RUN_SECS) $(QEMU_BIN) $(QEMU_ARGS) || test $$? -eq 124
	@echo ">> serial output:"
	@cat build/serial.log | tr -c '[:print:]\n' ' ' | grep -a . | tail -n 30

.PHONY: run

clean:
	rm -rf build $(KERNEL) $(ISO) $(IMG)

# ---- gitignore-style helpers ----
$(KERNEL_SRCS): ;

.PHONY: help
help:
	@echo "targets: all (vesper.elf), iso, img, run (QEMU/OVMF), doctor (env check), clean"
	@echo "env: QEMU_BIN, OVMF_DIR, OVMF_CODE, OVMF_VARS, CONF, RUN_SECS"
